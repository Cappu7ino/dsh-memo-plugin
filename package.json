{
  "name": "@local/dsh-memo",
  "version": "1.0.0",
  "private": true,
  "description": "备忘录：带左侧栏入口的全局便签本，支持标签、置顶、完成与归档，并提供给 AI 的 memo 工具。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cappu7ino/dsh-memo-plugin.git"
  },
  "homepage": "https://github.com/Cappu7ino/dsh-memo-plugin#readme",
  "bugs": {
    "url": "https://github.com/Cappu7ino/dsh-memo-plugin/issues"
  },
  "author": "Cappu7ino <56630005+Cappu7ino@users.noreply.github.com>"
}
